{
  "name": "now-showing",
  "version": "2.4.0",
  "private": true,
  "description": "Installable, offline-capable PWA that shows movie posters from Plex, Jellyfin or Emby full-screen inside a decorative frame.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "demo": "node scripts/serve.mjs --mock",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
